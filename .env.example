# Twelve Data API & Market Data Mode
# Supported modes: live | simulation | replay
TWELVE_DATA_API_KEY=your_api_key_here
MARKET_DATA_MODE=live
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META
MARKET_DATA_QUEUE_SIZE=10000

# Database Connection (PostgreSQL for production/docker, falls back to SQLite if unreachable or configured)
DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# Built-in ChartBot Assistant (100% offline, zero external keys needed)
BOT_NAME=ChartBot

# Server Settings
HOST=0.0.0.0
PORT=8000

# Market Simulation & Risk Parameters
TICK_INTERVAL_SECONDS=1.0
INITIAL_CASH=100000.0
MAX_POSITION_EQUITY_PCT=0.25
POSITION_SIZE_CASH_PCT=0.10
SLIPPAGE_PCT=0.0005
COMMISSION_FLAT=1.00
